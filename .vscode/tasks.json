{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1 Остановить все процессы node",
      "type": "shell",
      "command": "taskkill /F /IM node.exe",
      "problemMatcher": []
    },
    {
      "label": "2 Сервер ПР5 на 8080 (порт страницы 5555)",
      "type": "shell",
      "command": "node tools/mock-server-pr5.js --port 8080 --origin http://localhost:5555",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "3 Сервер ПР5 на 8080, токен живёт 60 секунд",
      "type": "shell",
      "command": "node tools/mock-server-pr5.js --port 8080 --origin http://localhost:5555 --ttl 60",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "4 Лекционный сервер на 8080 (без добавок ПР5)",
      "type": "shell",
      "command": "node ../api/mock-server.js --port 8080 --origin http://localhost:5555",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "5 Приложение в Chrome, порт 5555",
      "type": "shell",
      "command": "flutter run -d chrome --web-port=5555",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "6 Приложение в Chrome: выход через 30 с, предупреждение за 10 с",
      "type": "shell",
      "command": "flutter run -d chrome --web-port=5555 --dart-define=INACTIVITY_SECONDS=30 --dart-define=INACTIVITY_WARNING_SECONDS=10",
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "7 Проверка проекта: analyze и test (результат в check.log)",
      "type": "shell",
      "command": "tools\\check.bat",
      "problemMatcher": []
    }
  ]
}